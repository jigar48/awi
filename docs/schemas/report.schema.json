{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 2 },
    "fingerprintVersion": { "type": "string", "const": "awi-sha256-v1" },
    "complete": { "type": "boolean" },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "traceId": { "type": "string", "pattern": "^trace-[1-9][0-9]*$" },
          "operations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "toolCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationMs": { "type": "number", "minimum": 0 },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["traceId", "operations", "toolCalls", "maxDepth"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "enum": [
              "AWI001",
              "AWI002",
              "AWI003",
              "AWI004",
              "AWI005",
              "AWI006",
              "AWI007"
            ]
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "string", "enum": ["high", "moderate"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "explanation": { "type": "string" },
          "remediation": { "type": "string" },
          "traceId": { "type": "string", "pattern": "^trace-[1-9][0-9]*$" },
          "operationIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^op-[1-9][0-9]*$" }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "operationId": {
                      "type": "string",
                      "pattern": "^op-[1-9][0-9]*$"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "format": { "type": "string", "enum": ["awi", "otel"] },
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["format", "index"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["operationId"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["references"],
            "additionalProperties": {}
          }
        },
        "required": [
          "ruleId",
          "severity",
          "confidence",
          "title",
          "description",
          "explanation",
          "remediation",
          "traceId",
          "operationIds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "traceId": { "type": "string", "pattern": "^trace-[1-9][0-9]*$" },
          "recordedTraceId": { "type": "string" },
          "operations": { "type": "array", "items": {} }
        },
        "required": ["traceId", "recordedTraceId", "operations"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "fingerprintVersion",
    "complete",
    "summaries",
    "findings",
    "warnings"
  ],
  "additionalProperties": false
}
