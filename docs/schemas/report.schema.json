{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "fingerprintVersion": { "type": "string", "const": "awi-sha256-v1" },
    "complete": { "type": "boolean" },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "traceId": { "type": "string" },
          "operations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "toolCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationMs": { "type": "number", "minimum": 0 },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": { "type": "number", "minimum": 0 },
              "outputTokens": { "type": "number", "minimum": 0 },
              "totalTokens": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "required": ["traceId", "operations", "toolCalls", "maxDepth"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "enum": ["AWI001", "AWI002", "AWI003", "AWI004", "AWI005", "AWI006"]
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "string", "enum": ["high", "moderate"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "explanation": { "type": "string" },
          "remediation": { "type": "string" },
          "traceId": { "type": "string" },
          "operationIds": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {}
          }
        },
        "required": [
          "ruleId",
          "severity",
          "confidence",
          "title",
          "description",
          "explanation",
          "remediation",
          "traceId",
          "operationIds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "traceId": { "type": "string" },
          "operations": { "type": "array", "items": {} }
        },
        "required": ["traceId", "operations"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "fingerprintVersion",
    "complete",
    "summaries",
    "findings",
    "warnings"
  ],
  "additionalProperties": false
}
