{
  "name": "agent-workflow-inspector",
  "version": "1.0.0",
  "description": "Local-first, deterministic linter for AI agent traces: detect suspicious retries, repeated tool calls, execution cycles, and resource burn.",
  "type": "module",
  "license": "MIT",
  "author": "Jigar Prajapati",
  "homepage": "https://github.com/jigar48/awi#readme",
  "bugs": {
    "url": "https://github.com/jigar48/awi/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/buildwithjigar"
  },
  "keywords": [
    "ai-agents",
    "agent-observability",
    "opentelemetry",
    "developer-tools",
    "typescript",
    "cli",
    "ai-debugging",
    "trace-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jigar48/awi.git"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "awi": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "awi.config.example.json",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "schemas": "pnpm build && node scripts/schemas.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "verify:quickstart": "node scripts/verify-quickstart.mjs"
  },
  "dependencies": {
    "commander": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.19.0",
    "tsup": "9.0.0",
    "vitest": "5.0.5",
    "eslint": "10.13.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2"
  }
}
